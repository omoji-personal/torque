     "event": {"tool_name": "Bash", "tool_input": {"command": "s'f' data create record --sobject Account --values Name=x --target-org acme-prod"}}},
    {"id": "CODEX-3 compound-write", "gate": "prod_write_gate", "expect": "deny",
     "event": {"tool_name": "Bash", "tool_input": {"command": "echo ok; sf data create record --sobject Account --values Name=x --target-org acme-prod"}}},
    {"id": "CODEX-3 and-write", "gate": "prod_write_gate", "expect": "deny",
     "event": {"tool_name": "Bash", "tool_input": {"command": "true && sf data update record --sobject Account --record-id 001 --values x --target-org acme-prod"}}},
    {"id": "K-4 sfdx legacy targetusername", "gate": "prod_write_gate", "expect": "deny",
     "event": {"tool_name": "Bash", "tool_input": {"command": "sfdx force:data:record:create --sobjecttype Account --values \"Name=x\" --targetusername acme-prod"}}},
    {"id": "K-4b legacy -u short flag", "gate": "prod_write_gate", "expect": "deny",
     "event": {"tool_name": "Bash", "tool_input": {"command": "sf data create record --sobject Account --values Name=x -u acme-prod"}}},
    {"id": "K-3 decoy first-target", "gate": "prod_write_gate", "expect": "deny",
