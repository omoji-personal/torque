#!/usr/bin/env python3
"""Run the release profile and record exactly what happened.

An attestation is the artifact a stranger uses to decide whether to believe the rest. This one
claimed, in its own docstring, to record "check outcomes, org verdict" — and wrote a file
containing tool versions, two hashes and a reproduce command. Neither of the two things it named.
That is the same defect as an image manifest recording that metadata was stripped from a file
nobody opened, and it sat in the artifact whose only job is to be trustworthy.

It now runs the validation itself and records the result: commit and tree, the target org's
classification with its Id digested rather than published, every check with its outcome, every
mutator, the self-test verdict, the final verdict, and when. If the run is not a pass, the
attestation says so — an attestation that could only ever describe success is a press release.

    torque attest --target-org <alias> [--profile release]
"""
import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "harness" / "attest"
# C2: same override as harness/validate.py, and resolved the same way on purpose. Two files
# naming one boundary is the drift this repo keeps finding; when the path moves, it has to move
# in both or the attestation records ABSENT for a denylist the run actually used.
DENY = Path(os.environ.get(
    "TORQUE_DENYLIST", Path.home() / "Desktop" / "torque-planning" / "denylist.txt"))


def sh(*a):
    r = subprocess.run(a, capture_output=True, text=True, cwd=ROOT)
    if r.returncode != 0:
        raise RuntimeError(f"{' '.join(a)} failed with exit {r.returncode}: "
                           f"{(r.stderr or r.stdout).strip()[:100]}")
    return r.stdout.strip()


def main():
    ap = argparse.ArgumentParser(prog="torque attest", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    # Required for capability and release, which reach an org. NOT for static, which does not
    # touch one — and demanding it there kept static attestations out of CI, which is the only
    # place they could be produced automatically. The newest attestation in this repo is around
    # sixty commits stale for exactly that reason: the artifact whose one job is to be
    # trustworthy was produced by hand, so it was produced rarely.
    ap.add_argument("--target-org")
    ap.add_argument("--profile", default="release",
                    choices=["static", "capability", "release"])
    # Somewhere other than harness/attest/. CI asserts the working tree is clean after the run —
    # a mutator that failed to restore a hook must not ride into a commit — and an attestation
    # written into the repo would trip that assertion with a file that is not residue at all.
    # Two true things collide unless the artifact can be put elsewhere and uploaded.
    ap.add_argument("--out", metavar="DIR",
                    help="directory to write the attestation into (default harness/attest)")
    a = ap.parse_args()
    if a.profile != "static" and not a.target_org:
        print(f"--target-org is required for --profile {a.profile}: it reaches a live org and "
              f"an attestation that cannot name which one attests nothing.", file=sys.stderr)
        return 2

    dirty = sh("git", "status", "--porcelain")

    # P1-008. A release attestation must map to one immutable commit and tree another person can
    # fetch exactly. From a dirty tree it does not: `git write-tree` records the INDEX, so the
    # recorded tree can name an object no commit reaches, and the checks ran against source the
    # reader cannot obtain. 15 of the 21 schema-2 attestations in this repo are PASS-from-dirty,
    # including the four most recent — the norm, not the exception.
    #
    # Checked BEFORE the run, not after. A release profile takes minutes against a live org, and
    # refusing at the end would spend all of it to tell the operator something knowable at the
    # start. Fail before the cost, not after it.
    if dirty and a.profile == "release":
        print("refusing: --profile release on a dirty working tree. A release attestation claims "
              "that a named commit and tree produce this result, and a reader can fetch neither. "
              "Commit or stash, then re-run.\n"
              f"uncommitted:\n{dirty[:400]}", file=sys.stderr)
        return 2

    started = int(time.time())
    _argv = [sys.executable, str(ROOT / "harness" / "validate.py"), "--profile", a.profile]
    if a.target_org:
        _argv += ["--target-org", a.target_org]
    run = subprocess.run(_argv, capture_output=True, text=True, cwd=ROOT)
    clean = re.sub(r"\x1b\[[0-9;]*m", "", run.stdout + run.stderr)

    checks = [{"check": m.group(1), "outcome": m.group(2), "detail": m.group(3).strip()}
              for m in re.finditer(
                  # validate.py prints NA and LIMITED; matching only N/A and LIMIT dropped
                  # every check with those outcomes from the attestation — silently shortening
                  # the artifact whose one job is to be complete.
                  r"^\s+[✓✗!−·⧗]\s+(\S+)\s+(PASS|FAIL|WARN|SKIP|N/A|NA|LIMIT|LIMITED)\s+(.*)$",
                  clean, re.M)]
    mutators = [m.group(1) for m in re.finditer(r"^\s+✓\s+(.+?) mutator:", clean, re.M)]
    # "ALL N MUTATORS CAUGHT" is printed only when NOTHING was skipped. Keying the count on it
    # meant any skipped mutator — the redaction one needs an org, so every static run — reported
    # `mutators_caught: 0` in the same document that listed sixteen mutators by name, each one
    # observed catching what it was pointed at. An artifact that contradicts itself in adjacent
    # fields is worse than one that admits a gap.
    self_test = re.search(r"ALL (\d+) MUTATORS CAUGHT", clean)
    not_run = re.search(r"NOT RUN:\s*(.+?)\s*$", clean, re.M)
    verdict = (re.search(r"→ verdict:\s+(\S+)", clean) or [None, "UNKNOWN"])[1]

    # The org's identity is attested without being published: a reader can confirm two runs hit
    # the same org, and cannot learn which org that is.
    #
    # A static run reached no org, so there is no identity to attest and none is invented. It
    # records N/A with the reason rather than an empty alias, because a null org field on an
    # attestation should say WHY it is null — "this profile does not touch an org" and "the org
    # did not answer" are opposite facts and the older code produced the same shape for both.
    if a.profile == "static":
        org = {"alias": None, "org_id_sha256_16": None,
               "note": "static profile reaches no org; nothing to attest here"}
    else:
        try:
            org_run = subprocess.run(
                ["sf", "org", "display", "--target-org", a.target_org, "--json"],
                capture_output=True, text=True)
            d = json.loads(org_run.stdout)["result"]
            org_id = d.get("id")
            if org_run.returncode != 0 or not re.fullmatch(
                    r"00D[A-Za-z0-9]{12}(?:[A-Za-z0-9]{3})?", org_id or ""):
                raise ValueError("org display returned no valid org id")
            org = {"alias": a.target_org,
                   "org_id_sha256_16": hashlib.sha256(org_id.encode()).hexdigest()[:16]}
        except Exception:
            org = {"alias": a.target_org, "org_id_sha256_16": None, "note": "org did not answer"}
            verdict = "UNKNOWN"

    # A dirty non-release run is still worth recording; it is just not a release claim. The
    # schema says which it is, in the field a reader looks at first. "2-draft" cannot be mistaken
    # for "2" by anything reading the file — the property the boolean never had, since
    # working_tree_clean:false sat in every one of those 15 and stopped nobody, being a detail
    # inside a document whose headline said PASS.
    att = {
        "schema": "torque.attestation/2" if not dirty else "torque.attestation/2-draft",
        "generated_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(started)),
        "duration_s": int(time.time()) - started,
        "head": sh("git", "rev-parse", "HEAD"),
        "tree": sh("git", "write-tree"),
        "working_tree_clean": not dirty,
        "profile": a.profile,
        "org": org,
        "org_classification": next(
            (c["detail"] for c in checks if c["check"] == "org_classify"), None),
        "verdict": verdict,
        "exit_code": run.returncode,
        "counts": {"checks": len(checks),
                   # Counted from what was actually parsed, rather than from a hand-written
                   # list of spellings — which had drifted from the parser's own alternation, so
                   # every NA and LIMIT total read zero (release panel round 3).
                   **{o.lower().replace("/", ""): sum(1 for c in checks if c["outcome"] == o)
                      for o in sorted({c["outcome"] for c in checks})}},
        "self_test": {"mutators_caught": int(self_test.group(1)) if self_test
                      else len(mutators),
                      "all_caught": bool(self_test),
                      "not_run": None if self_test else (not_run.group(1) if not_run
                                                         else "unstated"),
                      "mutators": mutators},
        "checks": checks,
        "toolchain": {"sf": sh("sf", "--version")[:60], "node": sh("node", "--version"),
                      "python": sys.version.split()[0]},
        "denylist_digest": (hashlib.sha256(DENY.read_bytes()).hexdigest()[:16]
                            if DENY.exists() else "ABSENT"),
        "reproduce": f"python3 harness/validate.py --profile {a.profile} "
                     f"--target-org <your-disposable-org>",
    }
    # A check line is `<mark> <single-token name> <ALL-CAPS OUTCOME> <detail>`. Self-test lines
    # share the mark but carry prose ("clean_ip fail-closed (denylist absent): expected FAIL"),
    # so counting by mark alone made this guard fire on its own first run. Matching the SHAPE
    # rather than the outcome vocabulary means a new outcome name is still counted — which is
    # the whole point: the guard exists to notice outcomes the parser does not know.
    # An eight-character ceiling meant a longer outcome name was invisible to the guard as well
    # as to the parser, so the two agreed on missing the same line and the guard passed.
    registered = len(re.findall(
        r"^\s+[✓✗!−·⧗]\s+\S+\s+[A-Z][A-Z0-9_/-]*\s", clean, re.M))
    if checks and len(checks) != registered:
        print(f"refusing: parsed {len(checks)} check lines but the run printed {registered} — "
              f"an attestation that silently drops outcomes is worse than none", file=sys.stderr)
        return 2
    if not checks:
        print("refusing to write an attestation with no check outcomes — the validation run "
              "produced nothing parseable", file=sys.stderr)
        return 2
    if (verdict == "PASS") != (run.returncode == 0):
        print(f"refusing: validator verdict {verdict} disagrees with exit "
              f"{run.returncode}", file=sys.stderr)
        return 2
    out_dir = Path(a.out).expanduser() if a.out else OUT
    out_dir.mkdir(parents=True, exist_ok=True)
    f = out_dir / f"attest-{att['head'][:8]}.json"
    f.write_text(json.dumps(att, indent=2) + "\n")
    try:
        shown = f.relative_to(ROOT)
    except ValueError:
        shown = f
    print(f"{shown}  verdict={verdict}  "
          f"{att['counts'].get('pass', 0)}/{len(checks)} passed  "
          f"{att['self_test']['mutators_caught']} mutators caught")
    return 0 if verdict == "PASS" else 1


if __name__ == "__main__":
    sys.exit(main())
