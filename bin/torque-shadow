#!/usr/bin/env python3
"""Run an operation for its ERRORS, not its effects — inside a transaction that never commits.

WHY
An agent that knows Salesforce still guesses, fails, adjusts and retries against a live org, and
every retry is a real mutation. That is not a knowledge gap; documentation does not close it. The
gap is feedback: the agent cannot find out what the org will say without telling the org to do it.

So it does it, and then does not. A Savepoint, the real DML, the real runtime errors — validation
rules, required fields, flow exceptions, trigger failures, all raised by the platform rather than
predicted from metadata — and then Database.rollback. The agent learns from the org's own error
message instead of from its priors.

Proven against a live Developer Edition org: an insert observed with the owner the platform
assigned, a genuine REQUIRED_FIELD_MISSING captured, residue zero.

WHAT DOES NOT ROLL BACK — measured on a live org, not assumed
  GOVERNOR LIMITS ARE SPENT. Measured: DML statements went 2 -> 3 ACROSS the rollback, because
  the rollback itself is a DML statement and the counters do not reset. A shadow run costs the
  transaction budget it would have cost for real, plus one. Shadowing an operation already near a
  limit will hit that limit.
  Independently reproduced 2026-08-04 by harness/experiments/shadow-rollback-boundary.py, four
  runs against a Developer Edition org: 0 → 2 → 3 statements and 0 → 1 → 1 rows across
  setSavepoint, one insert, and Database.rollback. Now also a catalogue entry
  (savepoint-rollback-does-not-refund-limits) so the requirement reaches an operator who never
  opens this file.

  Not covered by a savepoint at all, and so out of scope here: callouts (already sent), @future
  and Queueable (already enqueued), Platform Events published with publishImmediate, and Change
  Data Capture. An operation whose consequence leaves the transaction cannot be un-done by
  rolling the transaction back, and this tool does not pretend otherwise.

  THAT LIST IS DOCUMENTED, NOT MEASURED, and the distinction is worth keeping. The limits claim
  above has been reproduced; the async and event claims have not. Four experiment designs tried
  and failed to establish the Queueable half against a live org — AsyncApexJob held zero rows
  ever, and a Queueable declared as an inner class inside anonymous Apex left no side effect
  even when enqueued and committed, so the control arm never showed up and every treatment
  result was uninterpretable. Establishing it needs a deployed ApexClass, which an experiment
  must not push into somebody's org. The guard regexes below refuse these shapes regardless,
  which is the safe direction and does not turn the claim into a measurement.

NEVER AGAINST PRODUCTION. A savepoint bounds the DATA, not the risk: triggers fire, flows run,
async work enqueues, limits burn. Refused here, and refused again by the gates.
"""
from __future__ import annotations
import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "hooks"))
import lib  # noqa: E402

TEMPLATE = """List<String> tqObs = new List<String>();
// ASYNC BASELINE, taken BEFORE the savepoint.
//
// The escape guards below scan the SUBMITTED SOURCE for callout/@future/Queueable/event shapes.
// That cannot see what a body reaches through: `ExistingService.process();` matches no regex
// while the class it calls enqueues a Queueable, publishes an event, or fires a callout — and an
// enqueued job does not roll back. Two external reviews named this the same way, and it is the
// shape an agent produces most naturally, because reusing an existing class is what agents do.
//
// A regex cannot be made to see it. A COUNT can: AsyncApexJob rows created during the
// transaction survive the rollback, so a before/after delta is evidence rather than a guess. It
// needs no job Id and no control arm — any positive delta means something escaped.
//
// Deliberately not a guard. It cannot PREVENT the escape (the enqueue has already happened by
// the time we count), so it exists to stop the tool reporting "residue none" when something did
// leave the transaction. Detection, honestly labelled, rather than a boundary claim.
Integer tqAsync0 = -1;
try { tqAsync0 = [SELECT COUNT() FROM AsyncApexJob]; } catch (Exception tqIgn) {}
Savepoint tqSp = Database.setSavepoint();
Integer tqDml0 = Limits.getDmlStatements();
Integer tqSoql0 = Limits.getQueries();
try {
%(body)s
    tqObs.add('OUTCOME~@~succeeded');
} catch (Exception tqE) {
    tqObs.add('OUTCOME~@~failed~@~' + tqE.getTypeName() + '~@~' + tqE.getMessage());
} finally {
    Database.rollback(tqSp);
    // Emitted only after rollback() actually returns, so "residue none" is an OBSERVATION
    // rather than a claim the template makes on the transaction's behalf. If the rollback
    // throws, or the process dies first, this line never appears and the caller reports
    // residue UNCONFIRMED instead of asserting zero (P0-002).
    tqObs.add('ROLLBACK~@~done');
}
// Counted AFTER the rollback, because that is the question: did anything survive it. Reports
// `unknown` rather than `0` when either count failed — an async delta that could not be measured
// and an async delta of zero are different facts, and only one of them is reassuring.
Integer tqAsync1 = -1;
try { tqAsync1 = [SELECT COUNT() FROM AsyncApexJob]; } catch (Exception tqIgn2) {}
tqObs.add('ASYNC~@~' + ((tqAsync0 < 0 || tqAsync1 < 0)
                        ? 'unknown' : String.valueOf(tqAsync1 - tqAsync0)));
tqObs.add('COST~@~dml=' + (Limits.getDmlStatements() - tqDml0)
          + '~@~soql=' + (Limits.getQueries() - tqSoql0)
          + '~@~cpu=' + Limits.getCpuTime());
for (String tqO : tqObs) System.debug('TORQUE_SHADOW>>> ' + tqO);
"""


def main() -> int:
    ap = argparse.ArgumentParser(description="run Apex for its errors, then roll it back")
    ap.add_argument("--target-org", required=True)
    ap.add_argument("--file", help="Apex to run inside the savepoint")
    ap.add_argument("--apex", help="Apex source inline")
    a = ap.parse_args()
    if not (a.file or a.apex):
        ap.error("give --file or --apex")

    body_src = Path(a.file).read_text() if a.file else (a.apex or "")

    # P0-001, found by external audit against code shipped hours earlier, and confirmed here:
    # `sf apex run` is blocked by the gates and requires an operator-approved, hash-pinned copy.
    # This tool invokes it as a subprocess, so the hook never sees the inner call — it saw only
    # `python3 bin/torque-shadow ...` and allowed it. That handed the agent an arbitrary-Apex
    # path AROUND the anonymous-Apex control.
    #
    # The docstring above already listed what does not roll back. Listing a risk is not gating
    # it. So the gate is on the RISK rather than on "it is Apex": refuse anything whose effect
    # can leave the transaction, and refuse protected objects. What remains — triggers and flows
    # firing on a verified developer org, then rolled back — is what the tool is for.
    ESCAPES = {
        "callout": r"\bHttp\s*\(|HttpRequest|@future\s*\(\s*callout\s*=\s*true|WebServiceCallout",
        "async work": r"@future|System\.enqueueJob|Database\.executeBatch|System\.schedule",
        "event that cannot be rolled back": r"publishImmediate|EventBus\.publish",
        "email": r"Messaging\.send",
    }
    escaped = [name for name, pat in ESCAPES.items() if re.search(pat, body_src, re.I)]
    if escaped:
        print(f"REFUSED: this Apex can leave the transaction ({', '.join(escaped)}). A savepoint "
              f"cannot roll back a consequence that has already left it, so shadowing it would "
              f"promise a safety it does not have.", file=sys.stderr)
        return 2
    shielded = lib.protected_object_hits(body_src)
    if shielded:
        print(f"REFUSED: references a protected object ({', '.join(shielded)}).", file=sys.stderr)
        return 2

    verdict, orgid, username = lib.classify_live(a.target_org)
    if verdict not in lib.ELIGIBLE:
        print(f"REFUSED: {a.target_org} classified {verdict!r}. Shadow execution runs the real "
              f"operation — triggers fire, flows run, async work enqueues and governor budget is "
              f"spent. The savepoint bounds the DATA, not the risk.", file=sys.stderr)
        return 2

    body = body_src
    body = "\n".join("    " + ln for ln in body.strip().splitlines())
    src = TEMPLATE % {"body": body}
    tmp = ROOT / "local" / ".shadow.apex"
    tmp.parent.mkdir(exist_ok=True)
    tmp.write_text(src)
    try:
        # P0-003: the alias was CLASSIFIED and then the ALIAS was executed. An alias is
        # mutable, so anything re-pointing it between the two runs the operation against an org
        # that was never checked. Execute the resolved username instead, and revalidate that it
        # still carries the org Id the verdict was made about.
        #
        # This is not atomicity and is not claimed as such — the audit's own remedy overstates
        # that, and the external verification said so. Checking and executing remain two
        # operations; real atomicity needs a broker that binds credential selection to
        # execution. What this removes is the mutable indirection, which is the exploitable part.
        target = username or a.target_org
        _v2, orgid2, _u2 = lib.classify_live(target)
        if orgid2 != orgid or _v2 not in lib.ELIGIBLE:
            print(f"REFUSED: {a.target_org} resolved to {target}, which no longer presents the "
                  f"org that was verified ({orgid} -> {orgid2}, {verdict} -> {_v2}).",
                  file=sys.stderr)
            return 2
        r = subprocess.run(["sf", "apex", "run", "--file", str(tmp),
                            "--target-org", target],
                           capture_output=True, text=True, timeout=300)
    finally:
        tmp.unlink(missing_ok=True)

    out = [ln.split("TORQUE_SHADOW>>> ", 1)[1].strip()
           for ln in (r.stdout + r.stderr).splitlines() if "TORQUE_SHADOW>>> " in ln]
    obs = [o for o in out if "~@~" in o]        # the CLI echoes the source line too
    if not obs:
        print("no observation returned — the shadow transaction did not report.\n"
              + lib.first_line(r.stderr, r.stdout)[:200], file=sys.stderr)
        return 3

    print(f"\nSHADOW RUN — {a.target_org} ({verdict}, {orgid})")
    rc = 0
    rolled_back = False
    async_delta = None
    for o in obs:
        parts = o.split("~@~")
        if parts[0] == "OUTCOME" and parts[1] == "failed":
            print(f"  FAILED   {parts[2]}")
            print(f"           {'~@~'.join(parts[3:])[:300]}")
            rc = 1
        elif parts[0] == "OUTCOME":
            print("  SUCCEEDED — it would have worked")
        elif parts[0] == "COST":
            print(f"  cost     {'  '.join(parts[1:])}   (SPENT — a rollback does not refund "
                  f"governor limits; the rollback itself is one DML statement)")
        elif parts[0] == "ROLLBACK":
            rolled_back = True
        elif parts[0] == "ASYNC":
            async_delta = parts[1] if len(parts) > 1 else "unknown"
        else:
            print(f"  {o}")

    # P0-002, first half. The marker lines were the whole verdict, so a NONZERO `sf apex run`
    # still printed SUCCEEDED as long as an OUTCOME line appeared anywhere in the output. An
    # anonymous-Apex call can fail after the observation is emitted — a compile error on a later
    # block, a governor limit, a killed process — and the tool would report that the operation
    # "would have worked". Reporting success on a failed invocation is the exact class this
    # project exists to refuse, in the tool built to rehearse operations safely.
    if r.returncode != 0 and rc == 0:
        print(f"  INCONCLUSIVE — the Apex reported success, but `sf apex run` exited "
              f"{r.returncode}. The observation cannot be trusted over the invocation that "
              f"produced it.")
        print(f"           {lib.first_line(r.stderr, r.stdout)[:200]}")
        rc = 3

    # P0-002, second half. "residue none" was printed unconditionally, including on the paths
    # where nothing established it. The rollback is claimed by the template; it should be
    # OBSERVED. If the transaction did not report rolling back, say that instead of asserting it.
    if rolled_back:
        # "The DATABASE rolled back" and "nothing escaped" are different claims, and printing the
        # first while implying the second is what the async delta exists to stop. An enqueued job
        # survives Database.rollback; the count taken after it is the only evidence either way.
        if async_delta is None or async_delta == "unknown":
            print("  residue  database rolled back; async escape UNMEASURED — the AsyncApexJob "
                  "count could not be taken, so whether work was enqueued is unestablished")
            if rc == 0:
                rc = 3
        elif async_delta != "0":
            print(f"  residue  database rolled back, but {async_delta} async job(s) were "
                  f"ENQUEUED and did not roll back with it. Something the source scan could not "
                  f"see reached @future, Queueable or Batch — most likely through a class the "
                  f"body called rather than anything written in it.")
            rc = 1
        else:
            print("  residue  none — the transaction reported its rollback, and no async job "
                  "was enqueued (AsyncApexJob delta 0, measured across the rollback)")
    else:
        print("  residue  UNCONFIRMED — no rollback observation was returned. The template rolls "
              "back to the savepoint, but this run did not see it reported, so treat residue as "
              "unestablished rather than zero.")
        if rc == 0:
            rc = 3
    print("  NOT covered: callouts, publishImmediate events, CDC — a consequence that left the "
          "transaction cannot be rolled back with it. @future/Queueable/Batch are now DETECTED "
          "after the fact by the AsyncApexJob delta, which is not the same as prevented.\n")
    return rc


if __name__ == "__main__":
    sys.exit(main())
