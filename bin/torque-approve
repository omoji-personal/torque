#!/usr/bin/env python3
"""torque approve — mint a single-use, HMAC-SIGNED approval token. OPERATOR-PRESENT ONLY.

Refuses unless invoked from a real interactive TTY whose FULL process ancestry is clear of
the Claude Code agent (walked to the top on both Linux /proc and macOS ps — a one-hop check
was launderable via `script`, audit HM3). The token is signed with a secret that lives at
~/.torque/secret (mode 0600, created here on first use); the agent's Bash tool is denied any
reference to it, so an agent cannot compute a valid signature and mint its own token.

Usage:
  torque approve <orgId> <op_class> [digest]
  torque approve <orgId> apex --apex-file <path>   # writes the approved immutable copy and
                                                   # binds the token to its content digest
op_class ∈ apex | bulk-delete | bulk-write | where-delete | where-update | destructive-metadata
"""
import json, os, sys, time, hashlib, subprocess
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
import lib


def _has_tty():
    try:
        fd = os.open("/dev/tty", os.O_RDWR); os.close(fd)
        return sys.stdin.isatty()
    except OSError:
        return False


def _ancestry_names():
    names, pid = [], os.getppid()
    if os.path.isdir("/proc"):
        for _ in range(40):
            if pid <= 1:
                break
            try:
                names.append(open(f"/proc/{pid}/comm").read().strip().lower())
                pid = int(open(f"/proc/{pid}/stat").read().split()[3])
            except Exception:
                break
        return names
    for _ in range(40):                               # macOS: walk the full ps ppid chain
        if pid <= 1:
            break
        try:
            out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)],
                                 capture_output=True, text=True).stdout.strip()
            if not out:
                break
            parts = out.split(None, 1)
            names.append((parts[1] if len(parts) > 1 else "").lower())
            pid = int(parts[0])
        except Exception:
            break
    return names


def _ancestry_clear():
    return not any("claude" in n or "node" in n for n in _ancestry_names())


def _ensure_secret():
    lib.ANCHOR.mkdir(parents=True, exist_ok=True)
    os.chmod(lib.ANCHOR, 0o700)
    if not lib.SECRET.exists():
        lib.SECRET.write_bytes(os.urandom(32))
        os.chmod(lib.SECRET, 0o600)


def _confirm(prompt):
    with open("/dev/tty") as tty:
        sys.stderr.write(prompt); sys.stderr.flush()
        return tty.readline().strip() == "YES"


def main():
    if not _has_tty():
        print("torque approve: refused — no interactive TTY (operator presence required)",
              file=sys.stderr); sys.exit(3)
    if not _ancestry_clear():
        print("torque approve: refused — invoked under the agent process ancestry",
              file=sys.stderr); sys.exit(3)
    args = sys.argv[1:]
    if len(args) < 2:
        print("usage: torque approve <orgId> <op_class> [digest | --apex-file <path>]",
              file=sys.stderr); sys.exit(2)
    orgid, op = lib.norm_id(args[0]), args[1]
    digest = ""
    apex_src = None
    if "--apex-file" in args:
        apex_src = args[args.index("--apex-file") + 1]
    elif len(args) > 2:
        digest = args[2]

    _ensure_secret()

    # Anonymous Apex: write the operator-approved IMMUTABLE copy under the anchor and bind the
    # token to its content digest. The gate re-reads THIS copy (agent cannot alter it).
    if op == "apex":
        if not apex_src:
            print("apex approval requires --apex-file <path>", file=sys.stderr); sys.exit(2)
        body = Path(os.path.expanduser(apex_src)).read_bytes()
        digest = hashlib.sha256(body).hexdigest()[:16]
        preview = body.decode("utf-8", "replace")
        sys.stderr.write("\n----- apex to approve -----\n" + preview[:2000] +
                         ("\n... (truncated)\n" if len(preview) > 2000 else "\n") +
                         "---------------------------\n")
        lib.APPROVED.mkdir(parents=True, exist_ok=True); os.chmod(lib.APPROVED, 0o700)
        dst = lib.APPROVED / f"{digest}.apex"
        dst.write_bytes(body); os.chmod(dst, 0o400)   # read-only approved copy

    if not _confirm(f"Approve {op} on org {orgid}"
                    f"{' digest ' + digest if digest else ''}? [type YES]: "):
        print("aborted", file=sys.stderr); sys.exit(1)

    lib.TOKENS.mkdir(parents=True, exist_ok=True); os.chmod(lib.TOKENS, 0o700)
    payload = {"orgId": orgid, "op": op, "digest": digest,
               "exp": int(time.time()) + 300, "iat": int(time.time())}
    payload["sig"] = lib.sign(payload)                # HMAC over the payload (sans sig)
    p = lib.token_path(orgid, op, digest)
    p.write_text(json.dumps(payload)); os.chmod(p, 0o600)
    print(f"approved: single-use HMAC token for {op} on {orgid} (5 min)"
          + (f"; apex copy at {dst}" if op == "apex" else ""))


if __name__ == "__main__":
    main()
