#!/usr/bin/env python3
"""torque approve — mint single-use, HMAC-SIGNED approvals. OPERATOR-PRESENT ONLY.

Presence proof (hardened after audit R10-07): a real interactive /dev/tty, whose device is an
ACTIVE LOGIN SESSION in `who` (a synthetic pty the agent forges is not a login and is refused),
and whose process ancestry is clear of the agent. The signing secret at ~/.torque/secret is
never exposed to the agent's tools, so a valid signature cannot be produced without a present
operator. (A same-uid actor executing a bespoke pty-reparenting + utmp-injection program is the
disclaimed Layer-0 boundary — that is arbitrary code execution, not the tool surface.)

Usage:
  torque approve <org> <op> [digest|--apex-file <path>]     # non-prod destructive op token
  torque approve <org> <op> --prod [--apex-file <path>]     # PRODUCTION single-op override
  torque approve <org> --session <minutes>                  # PRODUCTION window (<=120 min)
  torque approve <org> --end-session                        # revoke the window
op ∈ apex | bulk-delete | bulk-write | where-delete | where-update | destructive-metadata | write
"""
import json, os, sys, time, hashlib, subprocess
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "hooks"))
import lib

ROOT = Path(__file__).resolve().parent.parent

DESTRUCTIVE_OPS = {"apex", "bulk-delete", "bulk-write", "where-delete", "where-update",
                   "destructive-metadata"}
SESSION_MAX_MIN = 120
# A maintainer window is bounded by the WORK, not by the same clock as a production-write
# session, and the two should not share a number just because they started with one.
#
# A production session is dangerous while it is open: every minute is a minute in which a
# mistaken write reaches a customer's org. Short is correct there, and 120 stays.
#
# A maintainer window is dangerous at the MOMENT IT IS OPENED, because that is when a human
# decides the agent may edit the enforcement layer. After that decision, an expiry that lands
# mid-task buys nothing: the work is unfinished, the operator is asked to re-authorise the same
# thing they just authorised, and the ritual degrades into a reflex. A rubber-stamped renewal is
# worth less than one deliberate grant.
#
# 12 hours covers an overnight autonomous run, which is the actual use. It is still time-boxed,
# still revocable with --end-maintainer, still tree-bound, and every edit under it is still
# audited as MAINTAINER-EDIT. What it is not is a prompt that fires when nobody is awake.
MAINTAINER_MAX_MIN = 720


def _ensure_secret():
    lib.ANCHOR.mkdir(parents=True, exist_ok=True); os.chmod(lib.ANCHOR, 0o700)
    if not lib.SECRET.exists():
        lib.SECRET.write_bytes(os.urandom(32)); os.chmod(lib.SECRET, 0o600)


def _org_details(target):
    r = lib._sf("org", "display", "--target-org", target, "--json")
    try:
        d = json.loads(r.stdout)["result"]
        return lib.norm_id(d.get("id")), d.get("username"), d.get("instanceUrl")
    except Exception:
        pass
    # `sf org display` resolves an alias or a username, NOT an org Id — but the gate only knows
    # the org Id at deny time, so the remediation it prints ("torque approve 00D... bulk-delete")
    # landed here and died with "cannot resolve org". The command the product tells you to run
    # has to run. Fall back to the allowlist, which maps Id -> username for every org the
    # operator has already authorised.
    try:
        wanted = lib.norm_id(target)
        for e in (lib.load_allowlist() or {}).values():   # load_allowlist returns a DICT; iterating it yielded orgId STRINGS, so e.get() raised and the fallback silently resolved nothing — the gate then printed remediation that could not work
            if lib.norm_id(e.get("orgId") or e.get("org_id") or "") == wanted:
                user = e.get("username") or e.get("alias")
                if user:
                    r2 = lib._sf("org", "display", "--target-org", user, "--json")
                    try:
                        d2 = json.loads(r2.stdout)["result"]
                        return lib.norm_id(d2.get("id")), d2.get("username"), d2.get("instanceUrl")
                    except Exception:
                        return wanted, user, e.get("instanceUrl")
    except Exception:
        pass
    return None, None, None


def _maintainer(args):
    """Open or revoke a window in which the agent may edit Torque's OWN source.

    Deliberately org-free: it takes no target, resolves no org, and mints nothing an org
    operation could spend. A maintainer window is about the repository, and conflating it with
    org authority is exactly the mistake that would make it dangerous.
    """
    if args[0] == "--end-maintainer":
        lib.MAINTAINER_GRANT.unlink(missing_ok=True)
        lib.audit("MAINTAINER-REVOKE", "maintainer window revoked", durable=True)
        print("maintainer window revoked")
        return
    try:
        mins = int(args[1])
    except (IndexError, ValueError):
        print("usage: torque approve --maintainer <minutes>", file=sys.stderr); sys.exit(2)
    if mins <= 0:
        print("minutes must be positive", file=sys.stderr); sys.exit(2)
    mins = min(mins, MAINTAINER_MAX_MIN)
    tree = str(lib.TORQUE_HOME.resolve())
    with open("/dev/tty") as tty:
        sys.stderr.write(
            f"\n*** MAINTAINER WINDOW ***\n"
            f"  tree:     {tree}\n"
            f"  duration: {mins} min\n"
            f"The agent may edit Torque's own source under that tree — hooks, gates, checks,\n"
            f"commands, skills. Every edit is audited as MAINTAINER-EDIT.\n"
            f"It does NOT authorize any org write: production stays denied, destructive\n"
            f"operations still need their own token, and the trust anchor stays unreachable.\n"
            f"Type exactly  MAINTAIN  to authorize: ")
        sys.stderr.flush()
        if tty.readline().strip() != "MAINTAIN":
            print("refused", file=sys.stderr); sys.exit(3)
    _ensure_secret()
    g = {"tree": tree, "exp": int(time.time()) + mins * 60, "iat": int(time.time())}
    g["sig"] = lib.sign(g)
    lib.ANCHOR.mkdir(parents=True, exist_ok=True); os.chmod(lib.ANCHOR, 0o700)
    lib.MAINTAINER_GRANT.write_text(json.dumps(g)); os.chmod(lib.MAINTAINER_GRANT, 0o600)
    lib.audit("MAINTAINER-GRANT", f"{mins}m source-edit window for {tree}", durable=True)
    print(f"maintainer window open for {mins} min ({tree})")
    print("revoke: torque approve --end-maintainer")


def _confirm(prompt):
    with open("/dev/tty") as tty:
        sys.stderr.write(prompt); sys.stderr.flush()
        return tty.readline().strip() == "YES"


def _confirm_prod(target, orgid, username, instance):
    with open("/dev/tty") as tty:
        sys.stderr.write(
            f"\n*** PRODUCTION WRITE ***\n  org:      {target}  ({orgid})\n"
            f"  user:     {username}\n  instance: {instance}\n"
            f"Type exactly  WRITE PRODUCTION  to authorize: ")
        sys.stderr.flush()
        return tty.readline().strip() == "WRITE PRODUCTION"


def _mint(op, orgid, digest="", impact=None):
    lib.TOKENS.mkdir(parents=True, exist_ok=True); os.chmod(lib.TOKENS, 0o700)
    payload = {"orgId": orgid, "op": op, "digest": digest,
               "exp": int(time.time()) + 300, "iat": int(time.time())}
    if impact:
        # Signed alongside everything else, so the approved SIZE cannot be edited after the fact.
        payload["impact"] = impact
    payload["sig"] = lib.sign(payload)
    p = lib.token_path(orgid, op, digest)
    p.write_text(json.dumps(payload)); os.chmod(p, 0o600)


def _approve_impact(target, orgid, args):
    """Show what the operation will actually touch, then bind the token to that scope.

    Everywhere else, approval is per-command-string or per-session: the operator vouches for
    their own reading of a WHERE clause, and nothing checks it again. Here the blast radius is
    computed first and shown, the count is signed into the token, and the gate refuses later if
    the criteria now match MORE than was approved. A token for seven records cannot be spent on
    seven thousand.
    """
    def flag(name):
        return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) \
            else ""
    sobject, where = flag("--sobject"), flag("--where")
    if not sobject:
        print("--impact requires --sobject (and normally --where)", file=sys.stderr); sys.exit(2)
    op = args[1]
    br = ROOT / "bin" / "torque-blast-radius"
    r = subprocess.run([sys.executable, str(br), "--target-org", target, "--sobject", sobject,
                        "--operation", "delete" if "delete" in op else "update",
                        *(["--where", where] if where else [])],
                       capture_output=True, text=True, timeout=900)
    sys.stderr.write("\n" + r.stdout)
    if r.returncode != 0:
        sys.stderr.write("\n  The picture above is INCOMPLETE. Approving binds only the record "
                         "count, which is the part that was established.\n")
    q = f"SELECT COUNT() FROM {sobject}" + (f" WHERE {where}" if where else "")
    c = subprocess.run(["sf", "data", "query", "--target-org", target, "--json", "--query", q],
                       capture_output=True, text=True, timeout=300)
    try:
        scope = json.loads(c.stdout)["result"]["totalSize"]
    except Exception:
        print("could not establish the scope; refusing to mint an impact-bound token",
              file=sys.stderr)
        sys.exit(2)
    return lib.impact_digest(sobject, where), {
        "sobject": sobject, "where_sha": lib.impact_digest(sobject, where), "scope": scope}


def _write_approved_apex(apex_src):
    body = Path(os.path.expanduser(apex_src)).read_bytes()
    digest = hashlib.sha256(body).hexdigest()[:16]
    text = body.decode("utf-8", "replace")
    # show the FULL apex — never truncate (audit R11-09: a payload could hide past a cutoff)
    sys.stderr.write(f"\n----- apex to approve ({text.count(chr(10)) + 1} lines, sha {digest}) -----\n"
                     + text + "\n--------------------------------------------------\n")
    lib.APPROVED.mkdir(parents=True, exist_ok=True); os.chmod(lib.APPROVED, 0o700)
    dst = lib.APPROVED / f"{digest}.apex"
    dst.write_bytes(body); os.chmod(dst, 0o400)
    return digest


def _operator_present():
    return lib.operator_present()      # one implementation, in lib


def main():
    if not _operator_present():
        print("torque approve: refused — operator presence not proven (needs a real login TTY, "
              "clear of the agent process)", file=sys.stderr)
        sys.exit(3)
    args = sys.argv[1:]

    # Source-edit window: no org, so it is dispatched before any org resolution below.
    if args and args[0] in ("--maintainer", "--end-maintainer"):
        return _maintainer(args)

    if len(args) < 2:
        print(__doc__, file=sys.stderr); sys.exit(2)
    target = args[0]
    orgid, username, instance = _org_details(target)
    if not orgid:
        print(f"torque approve: cannot resolve org '{target}'", file=sys.stderr); sys.exit(2)
    _ensure_secret()

    # ---- production session window ----
    if "--session" in args:
        try:
            mins = min(int(args[args.index("--session") + 1]), SESSION_MAX_MIN)
        except Exception:
            print("usage: torque approve <org> --session <minutes>", file=sys.stderr); sys.exit(2)
        if not _confirm_prod(target, orgid, username, instance):
            print("aborted", file=sys.stderr); sys.exit(1)
        lib.PROD_SESSIONS.mkdir(parents=True, exist_ok=True); os.chmod(lib.PROD_SESSIONS, 0o700)
        grant = {"orgId": orgid, "exp": int(time.time()) + mins * 60, "iat": int(time.time())}
        grant["sig"] = lib.sign(grant)
        p = lib.PROD_SESSIONS / f"{orgid}.grant"
        p.write_text(json.dumps(grant)); os.chmod(p, 0o600)
        print(f"PRODUCTION session opened for {target} — {mins} min. Every write is audited. "
              f"Revoke: torque approve {target} --end-session")
        return
    if "--end-session" in args:
        (lib.PROD_SESSIONS / f"{orgid}.grant").unlink(missing_ok=True)
        print(f"production session for {target} revoked"); return

    op = args[1]
    is_prod = "--prod" in args
    digest = ""
    impact = None
    if "--impact" in args:
        digest, impact = _approve_impact(target, orgid, args)
    elif op == "apex":
        if "--apex-file" not in args:
            print("apex approval requires --apex-file <path>", file=sys.stderr); sys.exit(2)
        digest = _write_approved_apex(args[args.index("--apex-file") + 1])
    elif len(args) > 2 and not args[2].startswith("--"):
        digest = args[2]

    if is_prod:
        if not _confirm_prod(target, orgid, username, instance):
            print("aborted", file=sys.stderr); sys.exit(1)
        _mint("prod-write", orgid, "")                 # authorizes the prod write itself
        if op in DESTRUCTIVE_OPS:
            _mint(op, orgid, digest, impact)           # + the destructive-class token
        print(f"PRODUCTION override minted for {op} on {target} (single use, 5 min)"
              + (f"; apex copy at {lib.APPROVED / (digest + '.apex')}" if op == "apex" else ""))
        return

    prompt = (f"Approve {op} on org {orgid}"
              + (f" affecting {impact['scope']} {impact['sobject']} record(s)" if impact
                 else (f" digest {digest}" if digest else "")) + "? [type YES]: ")
    if not _confirm(prompt):
        print("aborted", file=sys.stderr); sys.exit(1)
    _mint(op, orgid, digest, impact)
    print(f"approved: single-use token for {op} on {orgid} (5 min)"
          + (f" — bound to {impact['scope']} {impact['sobject']} record(s); the gate will "
             f"refuse if the criteria come to match more" if impact else ""))


if __name__ == "__main__":
    main()
