#!/usr/bin/env python3
"""torque — one entry point for the operator-facing tools.

WHY THIS EXISTS: every deny message tells the operator to run `torque approve ...`.
Before this shim there was no such command — only `bin/torque-approve` — so the single
most important instruction the product ever prints did not work as written. A safety
control the operator cannot invoke is not a safety control.

Dispatches `torque <sub> [args...]` to `bin/torque-<sub>`, so the documented form and
the real form are the same string.
"""
import os
import sys
from pathlib import Path

BIN = Path(__file__).resolve().parent
# `torque-shim-sf` is an implementation installed under the names `sf` and `sfdx`; it is not
# an operator command. Discovering every torque-* file exposed it as `torque shim-sf`, where it
# failed with an enforcement error that looked like a public command was broken.
INTERNAL = {"shim-sf"}
SUBS = sorted(p.name[len("torque-"):] for p in BIN.glob("torque-*")
              if p.is_file() and p.name[len("torque-"):] not in INTERNAL)


def _usage(problem="", code=2):
    out = sys.stderr if code else sys.stdout
    if problem:
        print(f"torque: {problem}\n", file=out)
    print(f"usage: torque <command> [args...]\n\ncommands:", file=out)
    for s in SUBS:
        print(f"  {s}", file=out)
    print(f"\nEach is also runnable directly as {BIN}/torque-<command>.", file=out)
    return code


def main():
    if len(sys.argv) < 2:
        return _usage()
    if sys.argv[1] in ("-h", "--help", "help"):
        return _usage(code=0)
    sub, rest = sys.argv[1], sys.argv[2:]
    target = BIN / f"torque-{sub}"
    if not target.is_file():
        return _usage(f"unknown command {sub!r}")
    # exec rather than subprocess: the child inherits this terminal unchanged, which the
    # approval flow REQUIRES — torque-approve refuses unless it is attached to a real TTY,
    # and a wrapper that broke that would silently disable operator-presence checking.
    os.execv(sys.executable, [sys.executable, str(target), *rest])


if __name__ == "__main__":
    sys.exit(main())
