#!/usr/bin/env bash
set -euo pipefail
torque_repo="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -n "${TORQUE_PYTHON:-}" ]]; then
  torque_python="$TORQUE_PYTHON"
elif [[ -x "$torque_repo/.venv-continuation/bin/python" ]]; then
  torque_python="$torque_repo/.venv-continuation/bin/python"
elif [[ -x "$torque_repo/.venv/bin/python" ]]; then
  torque_python="$torque_repo/.venv/bin/python"
else
  torque_python=python3
fi
exec "$torque_python" -m torque "$@"
