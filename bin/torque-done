#!/usr/bin/env python3
"""torque done — the ledger that decides whether the word is available.

The third failure in the roadmap's problem statement is declaring done on the wrong signal:
deploy status green, tests green, feature absent for every real user. Every part of that chain
reported success. The chain was never the question.

So this does not ask "did anything fail". It asks, layer by layer, "what was OBSERVED", and it
treats the absence of an observation as the absence of an observation. A layer nobody checked is
NOT VERIFIED. It is not passed, not assumed, not omitted from the count, and it is not silently
dropped from the denominator — which is the specific move that lets a partial check read as a
complete one.

    torque done --target-org <alias> --field Account.Tier__c --permset Tier_Access
    torque done --target-org <alias> --field Account.Tier__c --permset Tier_Access \
                --as-user tester@example.org --record-id 001XXXXXXXXXXXXXXX
    torque done --target-org <alias> --field Account.Tier__c --json

EXIT CODES
    0   DONE — every applicable layer verified
    3   NOT DONE — at least one applicable layer unverified or blocked
    2   REFUSED — the ledger could not be built, so no verdict exists

Exit 3 rather than 1 for NOT DONE, matching `torque blast-radius`: an incomplete picture and a
broken tool are different things and a caller has to be able to tell them apart.

THE BROWSER HALF, built 2026-08-15 from the procedure the 2026-08-04 experiment proved

The completion gate ends in the browser, rendering as a NON-ADMIN, because an admin sees
everything and therefore proves nothing. Given `--as-user` (the non-admin the change is for)
and `--record-id` (a record whose page should show the field), this impersonates that user via
the su servlet, opens the record in Lightning, and walks the shadow roots for the field's
LABEL — field-level security observed in the UI, not inferred from a permission row. Cost is
25–40 seconds live (the bare hop measured 10–19 before this was built; the reload and
Details-tab remedies buy honesty with the difference), still far under the two minutes that
gets a completion gate routed around.

The layer goes green only on the full chain: the ADMIN control saw the label (a detector that
fails its control measures nothing), the session was PROVEN to be somebody else (a hop that
silently stays admin passes every other assertion), and the label rendered for that somebody.
Anything less is UNANSWERED — never rounded to yes or to no. Admin, inactive and self targets
are refused out loud, because each renders perfectly and proves nothing.

Without those two flags the layer is BLOCKED — the tool cannot look without being told where —
and a person who did the render by hand records it with --render-evidence, which reports
ASSERTED, a different kind of knowing than the org answering.
"""
import argparse
import json
import re
import subprocess
import sys
from datetime import date
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

VERIFIED = "VERIFIED"
UNVERIFIED = "NOT VERIFIED"
BLOCKED = "BLOCKED"
# The org did not answer, so the verifier did not run. Distinct from NOT VERIFIED, which means
# it ran and the answer was no.
#
# WHY THIS EXISTS. An external audit gave a deterministic false-DONE: point the tool at an
# unreachable org, and field_exists and fls both come back NOT VERIFIED with the detail "the org
# could not answer" — then `--na` clears both, because --na cleared anything not BLOCKED. Add
# three evidence strings and every layer is green against an org that was never reached.
#
# The distinction was already in the DETAIL TEXT of every one of those branches and in none of
# the outcomes, so nothing downstream could act on it. An unanswered verifier is a fact about the
# tool and the environment, exactly like BLOCKED, and the same rule follows: it cannot be waived
# by the caller being graded.
UNANSWERED = "UNANSWERED"
# Supplied by a person rather than observed by a query. Green-eligible — otherwise the verdict is
# unreachable for every input and a ledger with one row carries no information — but counted and
# named separately in the verdict, because "a human said so" and "the org said so" are different
# kinds of knowing and conflating them is what made the false-DONE readable as a real one.
ASSERTED = "ASSERTED"
NA = "N/A"
GREEN = (VERIFIED, NA, ASSERTED)   # the outcomes that do not withhold the word
# Neither of these may be cleared by --na: one is the tool failing to look, the other is the tool
# being unable to look. Both are facts about the tool, not judgements about the change.
UNWAIVABLE = (BLOCKED, UNANSWERED)

# Where the render probe lives, and how long it may take. 240s is generous against the
# measured 10–19s so a slow org reports its own result rather than a timeout, while a hung
# browser still cannot hold the ledger hostage.
RENDER_PROBE = ROOT / "harness" / "checks" / "render_probe.mjs"
RENDER_TIMEOUT_S = 240


class Layer:
    def __init__(self, key, title, outcome, detail):
        self.key, self.title, self.outcome, self.detail = key, title, outcome, detail

    def as_dict(self):
        return {"layer": self.key, "title": self.title,
                "outcome": self.outcome, "detail": self.detail}


def sh(*args, timeout=120):
    return subprocess.run(["sf", *args], capture_output=True, text=True, timeout=timeout)


_NOISE = re.compile(r"^\s*(›\s*)?(warning|info|note|»)\b", re.I)
_ANSI = re.compile(r"\x1b\[[0-9;]*m")


def _why_it_failed(r):
    """The reason the call failed, not the first thing it printed.

    Taking stderr's first line looked right and was wrong the first time it ran: the Salesforce
    CLI leads with an update-available warning, so every failure in this ledger was reported as
    "@salesforce/cli update available", and an operator reading that would go and upgrade the
    CLI. A reason that sends someone to fix the wrong thing is worse than no reason, because
    they act on it. Prefer a line that names an error, drop the CLI's own chatter, and keep the
    escape codes out of it.
    """
    # Every call here passes --json, so a failure normally arrives as a JSON object carrying the
    # reason in a field. Read that first: it is the CLI stating its own error, rather than this
    # tool guessing which printed line was the important one.
    try:
        obj = json.loads(r.stdout or "")
        msg = (obj.get("message") or "").strip()
        code = (obj.get("code") or obj.get("name") or "").strip()
        if msg or code:
            # The CLI's message is multi-line and the FIRST line is the least useful one:
            # "Parsing --target-org", with "No authorization information found for <org>" on the
            # second. Taking line one produced a reason that named the flag and not the problem.
            # Collapse the whole thing instead, so nothing that explains the failure is dropped.
            flat = " ".join(_ANSI.sub("", msg).split())
            return (f"{code}: {flat}" if code and flat else (flat or code))[:220]
    except Exception:                                      # noqa: BLE001
        pass
    text = _ANSI.sub("", (r.stderr or "") + "\n" + (r.stdout or ""))
    lines = [l.strip(" ›\t") for l in text.splitlines() if l.strip() and l.strip() not in "{}"]
    real = [l for l in lines if not _NOISE.match(l)]
    named = [l for l in real if re.search(r"\berror\b|no org config|not found|expired|invalid",
                                          l, re.I)]
    pick = (named or real or lines)
    return (pick[0][:160] if pick else f"sf exited {r.returncode} and said nothing")


def soql(target, query, tooling=False):
    """Returns (rows, error). An error is NEVER an empty result.

    This confusion has now appeared in the parser, in blast-radius, in a probe script and in the
    catalogue verifier, so it is written out longhand here: a failed query, an unparseable
    response and a query that genuinely matched nothing are three different facts, and only one
    of them is "no". Callers get the error and must decide; nothing here turns it into zero.
    """
    # Which API serves which object is not a detail. FieldDefinition and EntityDefinition are
    # Tooling-only; FieldPermissions, PermissionSet and PermissionSetAssignment are ordinary
    # objects and the Tooling endpoint refuses them outright with "sObject type
    # 'FieldPermissions' is not supported". This helper hardcoded --use-tooling-api, so the two
    # layers that read permissions could never have returned a row — in any invocation, ever.
    # Every offline test passed, because against an unreachable org everything errors anyway and
    # the layer was going to be NOT VERIFIED regardless. It took one run against a real org.
    args = ["data", "query", "--target-org", target, "--json", "--query", query]
    if tooling:
        args.insert(4, "--use-tooling-api")
    try:
        r = sh(*args)
    except Exception as e:                                 # noqa: BLE001
        return None, f"{type(e).__name__} running the query"
    if r.returncode != 0:
        return None, _why_it_failed(r)
    try:
        return json.loads(r.stdout)["result"]["records"], None
    except Exception:                                      # noqa: BLE001
        return None, "the CLI returned something this could not parse as a query result"


def layer_field_exists(target, obj, field):
    rows, err = soql(target, "SELECT QualifiedApiName FROM FieldDefinition WHERE "
                             f"EntityDefinition.QualifiedApiName='{obj}' AND "
                             f"QualifiedApiName='{field}'", tooling=True)
    if err:
        return Layer("field_exists", f"{obj}.{field} exists in the org", UNANSWERED,
                     f"the org could not answer: {err}")
    if not rows:
        return Layer("field_exists", f"{obj}.{field} exists in the org", UNVERIFIED,
                     "the org answered, and the field is not there. A deploy that reported "
                     "success did not put it there either.")
    return Layer("field_exists", f"{obj}.{field} exists in the org", VERIFIED,
                 "confirmed by FieldDefinition, in the org, not in a deploy response")


def _is_custom(field):
    """`Widget__c` and `ns__Widget__c` are custom; `Name` and `CreatedDate` are not."""
    return field.endswith("__c") or field.endswith("__C")


def layer_fls(target, obj, field, permset):
    if not permset:
        # "Nothing was checked" was true and lazy. Without a named permission set this cannot
        # confirm the RIGHT grant exists, but it can still ask whether ANY does, and for a custom
        # field zero grants is the answer to the question people actually have. Reporting a
        # blank where a cheap query was available is the same withholding this tool exists to
        # stop, one level up.
        rows, err = soql(target, "SELECT Id FROM FieldPermissions WHERE "
                                 f"Field='{obj}.{field}'")
        if not _is_custom(field):
            # The custom-field rule is the usual cause here and it does not apply to a standard
            # field. Quoting it anyway would be a true sentence used as a false explanation.
            n = "an unknown number of" if err else str(len(rows))
            return Layer("fls", "field-level security granted", UNVERIFIED,
                         f"no --permset given, so no specific grant was confirmed. {field} is a "
                         f"STANDARD field, so the usual cause of this layer failing — no custom "
                         f"field gets FLS automatically from the Metadata API — does not apply "
                         f"to it. {n} permission row(s) mention it. Name a permission set to "
                         f"check the grant this change depends on.")
        if err:
            return Layer("fls", "field-level security granted", UNVERIFIED,
                         f"no --permset given, and the org could not be asked whether anything "
                         f"grants {field} at all: {err}")
        if not rows:
            return Layer("fls", "field-level security granted", UNVERIFIED,
                         f"no --permset given, and NOTHING grants {obj}.{field} to anyone. No "
                         f"custom field gets field-level security automatically from the "
                         f"Metadata API, for any profile, System Administrator included. The "
                         f"field is deployed and invisible.")
        return Layer("fls", "field-level security granted", UNVERIFIED,
                     f"no --permset given, so the specific grant this change depends on was not "
                     f"confirmed. {len(rows)} permission row(s) do grant {obj}.{field} to "
                     f"something, so it is not invisible to everyone. Name the permission set to "
                     f"turn this green.")
    rows, err = soql(target,
                     "SELECT Id, PermissionsRead, PermissionsEdit FROM FieldPermissions WHERE "
                     f"Field='{obj}.{field}' AND Parent.Name='{permset}'")
    if err:
        return Layer("fls", f"field-level security granted via {permset}", UNANSWERED,
                     f"the org could not answer: {err}")
    if not rows:
        return Layer("fls", f"field-level security granted via {permset}", UNVERIFIED,
                     f"no FieldPermissions row ties {obj}.{field} to {permset}. The field is "
                     f"deployed and nobody can see it.")
    readable = [r for r in rows if r.get("PermissionsRead")]
    if not readable:
        return Layer("fls", f"field-level security granted via {permset}", UNVERIFIED,
                     f"a FieldPermissions row exists on {permset} but grants no read")
    return Layer("fls", f"field-level security granted via {permset}", VERIFIED,
                 f"{len(readable)} permission row(s) grant read")


def layer_assigned(target, permset):
    if not permset:
        return Layer("assignment", "somebody actually holds the permission set", NA,
                     "no --permset given, so there is no assignment to check")
    # A permission set held through a Permission Set Group produces NO assignment row naming
    # the member set — the row names the group's aggregate set. Verified live 2026-08-07 on
    # sf-coffee: a user holding this set via a PSG returned COUNT 0 here while demonstrably
    # holding it. Every org above a certain size grants this way, so the direct query alone
    # reports "assigned to nobody" about a live permission.
    rows, err = soql(target, "SELECT COUNT(Id) c FROM PermissionSetAssignment WHERE "
                             f"PermissionSet.Name='{permset}'")
    if not err:
        direct = (rows[0].get("c") if rows else 0) or 0
        grp, gerr = soql(target,
                         "SELECT COUNT(Id) c FROM PermissionSetAssignment WHERE "
                         "PermissionSetGroupId IN (SELECT PermissionSetGroupId FROM "
                         "PermissionSetGroupComponent WHERE PermissionSet.Name="
                         f"'{permset}')")
        if gerr:
            # Do NOT fall back to `direct` — that is the false negative this fix exists to
            # stop. Half an answer reported as a whole one is the defect, not the remedy.
            return Layer("assignment", f"somebody actually holds {permset}", UNANSWERED,
                         f"direct assignments answered ({direct}), but group-based "
                         f"assignment could not be checked: {gerr}. Reporting the direct "
                         f"count alone would under-report anyone holding it through a "
                         f"permission set group.")
        rows = [{"c": direct + ((grp[0].get("c") if grp else 0) or 0)}]
    if err:
        return Layer("assignment", f"somebody actually holds {permset}", UNANSWERED,
                     f"the org could not answer: {err}")
    n = (rows[0].get("c") if rows else 0) or 0
    if not n:
        return Layer("assignment", f"somebody actually holds {permset}", UNVERIFIED,
                     f"{permset} exists, grants the field, and is assigned to nobody — "
                     f"directly or through any permission set group. Every "
                     f"query about the permission set says yes and no user can see the field.")
    return Layer("assignment", f"somebody actually holds {permset}", VERIFIED,
                 f"{n} assignment(s)")


def _browser_available():
    """node plus a Playwright chromium, from Playwright's documented locations (the C1 fix:
    only the author's macOS cache path was checked once, and the layer was BLOCKED forever
    everywhere else with the browser sitting right there)."""
    import os as _os
    import shutil as _sh
    if not _sh.which("node"):
        return "no `node` on PATH"
    cands = []
    if _os.environ.get("PLAYWRIGHT_BROWSERS_PATH"):
        cands.append(Path(_os.environ["PLAYWRIGHT_BROWSERS_PATH"]))
    cands += [Path.home() / "Library" / "Caches" / "ms-playwright",
              Path.home() / ".cache" / "ms-playwright"]
    if _os.environ.get("LOCALAPPDATA"):
        cands.append(Path(_os.environ["LOCALAPPDATA"]) / "ms-playwright")
    if not any(c.exists() and any(c.glob("chromium*")) for c in cands):
        return ("no Playwright chromium in any known location; "
                "`npx playwright install chromium` enables the render")
    return None


_USER_ID = re.compile(r"005[A-Za-z0-9]{12}(?:[A-Za-z0-9]{3})?$")


def _refuse(msg):
    print(msg, file=sys.stderr)
    sys.exit(2)


def _resolve_render(target, obj, field, as_user):
    """Everything the probe needs, from the org — or the reason it cannot be had.

    Returns (ctx, None) or (None, unanswered_detail). Caller MISTAKES — an admin target, an
    inactive one, the session's own user, a user the org has never heard of — refuse loudly
    with exit 2 instead of becoming a ledger row: each of those renders perfectly and proves
    nothing, and a measurement of nothing must not be phrased as a fact about the change.
    """
    r = sh("org", "display", "--target-org", target, "--json")
    if r.returncode != 0:
        return None, f"the org could not answer: {_why_it_failed(r)}"
    try:
        d = json.loads(r.stdout)["result"]
        instance = (d.get("instanceUrl") or "").rstrip("/")
        org_id = d.get("id") or ""
        session_username = d.get("username") or ""
        if not instance or not org_id:
            raise ValueError
    except Exception:                                      # noqa: BLE001
        return None, "org display returned no usable instance URL and org id"

    esc = as_user.replace("\\", "\\\\").replace("'", "\\'")
    where = (f"Id='{esc}'" if _USER_ID.fullmatch(as_user or "")
             else f"Username='{esc}'")
    rows, err = soql(target, "SELECT Id, Username, IsActive, Profile.Name, "
                             "Profile.PermissionsModifyAllData FROM User WHERE " + where)
    if err:
        return None, f"the org could not answer about {as_user!r}: {err}"
    if not rows:
        _refuse(f"--as-user {as_user!r} names no user in this org. The render must run as a "
                f"real user or it measures nothing.")
    u = rows[0]
    prof = (u.get("Profile") or {}).get("Name") or "unknown profile"
    if not u.get("IsActive"):
        _refuse(f"--as-user {as_user!r} is INACTIVE. Impersonating a dead account renders a "
                f"session no real user has, which proves nothing about who can see the field.")
    if (u.get("Profile") or {}).get("PermissionsModifyAllData"):
        _refuse(f"--as-user {as_user!r} holds an admin-class profile ({prof}, "
                f"ModifyAllData). An admin sees everything and proves nothing — name the "
                f"non-admin user the change is actually for.")

    srow, serr = soql(target, "SELECT Id FROM User WHERE Username="
                              f"'{session_username.replace(chr(39), chr(92)+chr(39))}'")
    session_id = (srow[0].get("Id") if srow and not serr else "") or ""
    if session_id and session_id[:15] == (u.get("Id") or "")[:15]:
        _refuse(f"--as-user {as_user!r} is the session's own user. Impersonating yourself is "
                f"a no-op that renders perfectly and measures nothing — authenticate as an "
                f"admin and name somebody else.")

    lrows, lerr = soql(target, "SELECT Label FROM FieldDefinition WHERE "
                               f"EntityDefinition.QualifiedApiName='{obj}' AND "
                               f"QualifiedApiName='{field}'", tooling=True)
    if lerr or not lrows or not lrows[0].get("Label"):
        return None, (f"the field's UI label could not be resolved from FieldDefinition"
                      f"{': ' + lerr if lerr else ''} — the field_exists layer says whether "
                      f"the field is there at all; without a label there is nothing to look "
                      f"for on the page")
    return {"instance": instance, "org_id": org_id, "session_id": session_id,
            "user_id": u["Id"], "username": u.get("Username", as_user),
            "profile": prof, "label": lrows[0]["Label"]}, None


def _render_outcome(marks, user_desc, label):
    """Probe marks in, (outcome, detail) out. Pure on purpose: this is the single place that
    decides what green means for the render, and the harness holds it to fixtures in both
    directions. Nothing here may round UNSETTLED to an answer.

    Order matters and is load-bearing: a probe that errored measured nothing; a servlet that
    never redirected was refused by the org; a detector that failed its ADMIN control cannot
    be trusted about anybody; a session not PROVEN to be somebody else renders as an admin,
    which passes every remaining assertion vacuously. Only past all four does the user's own
    result mean anything.
    """
    if "error" in marks:
        return UNANSWERED, f"the probe did not finish: {marks['error']}"
    if "servlet.su" in marks.get("suLandedPath", ""):
        return UNANSWERED, ("the su servlet did not redirect, so the org refused the "
                            "impersonation — 'Administrators Can Log in as Any User' "
                            "(enableAdminLoginAsAnyUser) is likely off. The render was "
                            "never measured.")
    if marks.get("adminShell") != "true":
        return UNANSWERED, ("Lightning never rendered for the admin session, so nothing "
                            "downstream was measured")
    if marks.get("adminFieldVisible") != "true":
        return UNANSWERED, (f"the detector could not see {label!r} even as an admin "
                            f"(adminFieldVisible={marks.get('adminFieldVisible', 'absent')}), "
                            f"so it cannot be trusted about {user_desc}. Check the record id, "
                            f"the page layout, and the label — a detector that fails its "
                            f"control measures nothing.")
    if not (marks.get("classicImpersonationMarker") == "true"
            or marks.get("impersonating") == "true"):
        return UNANSWERED, (f"the session could not be proven to be {user_desc} — no "
                            f"impersonation marker in Classic or Lightning — and an admin "
                            f"render proves nothing. Re-run, or record a by-hand render "
                            f"with --render-evidence.")
    seen = marks.get("asUserFieldVisible")
    if seen == "true":
        return VERIFIED, (f"{label!r} rendered on the record page for {user_desc}, "
                          f"impersonation confirmed in the UI, "
                          f"{marks.get('totalMs', '?')} ms end to end")
    if seen == "false":
        return UNVERIFIED, (f"the org's UI answered: {user_desc} cannot see {label!r}. The "
                            f"record page rendered and the field is not on it — deployed, "
                            f"and invisible exactly where it matters.")
    return UNANSWERED, (f"the record page never settled for {user_desc}, which is neither "
                        f"visible nor hidden. Re-run before believing either.")


def _run_render_probe(target, ctx, record_id, obj):
    """Frontdoor handoff, probe subprocess, marks. The URL file carries a live session token:
    the probe unlinks it on read, and the finally covers the launches that never got there —
    five stale token files in a temp dir taught check_p4 this rule the hard way."""
    fr = subprocess.run(["python3", str(ROOT / "bin" / "torque-frontdoor"), target],
                        capture_output=True, text=True)
    if fr.returncode != 0:
        return None, f"no frontdoor session URL: {(fr.stderr or '').strip()[:120]}"
    url_file = fr.stdout.strip()
    import os as _os
    env = {**_os.environ, "TORQUE_SESSION_USER_15": (ctx["session_id"] or "")[:15]}
    try:
        try:
            r = subprocess.run(
                ["node", str(RENDER_PROBE), url_file, ctx["instance"], ctx["org_id"],
                 ctx["user_id"], record_id, obj, ctx["label"]],
                capture_output=True, text=True, timeout=RENDER_TIMEOUT_S, env=env,
                cwd=str(ROOT))
        except subprocess.TimeoutExpired:
            return None, f"the probe did not finish within {RENDER_TIMEOUT_S}s"
        except Exception as e:                             # noqa: BLE001
            return None, f"the probe could not run: {type(e).__name__}"
    finally:
        Path(url_file).unlink(missing_ok=True)
    marks = dict(m.groups() for m in
                 re.finditer(r"^TORQUE~([A-Za-z0-9_]+)=(.*)$", r.stdout or "", re.M))
    if not marks:
        return None, (f"the probe emitted no marks (exit {r.returncode}): "
                      f"{(r.stderr or '').strip()[:120]}")
    return marks, None


def layer_profile_render(target, obj, field, a):
    """The layer the whole gate is for. Automated when the caller names WHERE to look.

    Green requires the org's UI to answer, through the full proven chain in _render_outcome.
    Without --as-user and --record-id the tool cannot look, so the layer is BLOCKED — a fact
    about this invocation, unwaivable by the caller being graded, exactly like every other
    verifier that did not run. --render-evidence remains the human seam and reports ASSERTED,
    because "a person looked" and "the org answered" are different kinds of knowing.
    """
    who = a.as_user or a.profile or "a non-admin user"
    title = f"visible in the UI as {who}"
    if a.as_user and a.record_id:
        why = _browser_available()
        if why:
            return Layer("profile_render", title, BLOCKED,
                         f"--as-user was given but the render cannot run here: {why}. Or do "
                         f"the render by hand and record it with --render-evidence.")
        ctx, detail = _resolve_render(target, obj, field, a.as_user)
        if ctx is None:
            return Layer("profile_render", title, UNANSWERED, detail)
        user_desc = f"{ctx['username']} ({ctx['profile']})"
        marks, err = _run_render_probe(target, ctx, a.record_id, obj)
        if marks is None:
            return Layer("profile_render", f"visible in the UI as {user_desc}",
                         UNANSWERED, err)
        outcome, detail = _render_outcome(marks, user_desc, ctx["label"])
        return Layer("profile_render", f"visible in the UI as {user_desc}", outcome, detail)
    if a.render_evidence:
        return Layer("profile_render", title, ASSERTED,
                     f"observed by a person: {a.render_evidence}")
    return Layer("profile_render", title, BLOCKED,
                 "not measured. The automated render exists and needs two inputs this run "
                 "did not give: --as-user (the non-admin the change is for; admins are "
                 "refused because they see everything and prove nothing) and --record-id "
                 "(a record whose page should show the field). Without them the tool cannot "
                 "look, and a layer nobody looked at is not green. A person who did the "
                 "render by hand records it with --render-evidence.")


def layer_automation(evidence):
    if not evidence:
        return Layer("automation", "the automation that should fire, fired", UNVERIFIED,
                     "no evidence supplied (--automation-evidence). Whether a flow saw the new "
                     "value depends on where it sits in order of execution, and a before-save "
                     "update behaves differently from an after-save one. Neither is in the "
                     "deploy response.")
    # ASSERTED, not VERIFIED: this is a string the caller typed. The tool did not watch the
    # flow fire. Returning VERIFIED here is what let `--automation-evidence "fine"` read as
    # though the org had answered.
    return Layer("automation", "the automation that should fire, fired", ASSERTED,
                 f"asserted by a person: {evidence}")


def layer_uat(evidence):
    if not evidence:
        return Layer("human_uat", "a human used it and agreed it works", UNVERIFIED,
                     "no evidence supplied (--uat-evidence). This layer is never machine "
                     "verifiable; it is listed so its absence is counted rather than forgotten.")
    # Never machine-verifiable by construction, so it can only ever be ASSERTED.
    return Layer("human_uat", "a human used it and agreed it works", ASSERTED,
                 f"asserted by a person: {evidence}")


def build(a):
    obj, _, field = (a.field or "").partition(".")
    if not obj or not field:
        print("--field must be Object.Field__c", file=sys.stderr)
        sys.exit(2)
    layers = [layer_field_exists(a.target_org, obj, field),
              layer_fls(a.target_org, obj, field, a.permset),
              layer_assigned(a.target_org, a.permset),
              layer_profile_render(a.target_org, obj, field, a),
              layer_automation(a.automation_evidence),
              layer_uat(a.uat_evidence)]
    for spec in a.na or []:
        key, _, reason = spec.partition(":")
        if not reason.strip():
            print(f"--na needs <layer>:<reason>, got {spec!r}. A layer declared inapplicable "
                  f"without a stated reason is a layer quietly deleted from the denominator.",
                  file=sys.stderr)
            sys.exit(2)
        hit = [l for l in layers if l.key == key.strip()]
        if not hit:
            print(f"--na names no layer called {key.strip()!r}. Layers: "
                  f"{', '.join(l.key for l in layers)}", file=sys.stderr)
            sys.exit(2)
        # Only an UNVERIFIED layer may be declared inapplicable. A BLOCKED one may not: that
        # would let the browser blocker be waved away by the person it is there to stop.
        if hit[0].outcome in UNWAIVABLE:
            print(f"--na cannot clear {key.strip()!r}: it is {hit[0].outcome}, not merely unchecked. "
                  f"A blocker and an unanswered org are both facts about the tool, not "
                  f"judgements about this change — and the caller being graded may not "
                  f"waive the verifier that failed to run.",
                  file=sys.stderr)
            sys.exit(2)
        hit[0].outcome, hit[0].detail = NA, f"declared inapplicable: {reason.strip()}"
    return layers


def render(layers, a):
    green = [l for l in layers if l.outcome in GREEN]
    observed = [l for l in layers if l.outcome == VERIFIED]
    asserted = [l for l in layers if l.outcome == ASSERTED]
    inapplicable = [l for l in layers if l.outcome == NA]
    done = len(green) == len(layers)
    if a.json:
        print(json.dumps({"target_org": a.target_org, "field": a.field,
                          "verdict": "DONE" if done else "NOT DONE",
                          "verified": len(green), "observed": len(observed),
                          "asserted": len(asserted), "inapplicable": len(inapplicable),
                          "layers": len(layers),
                          "ledger": [l.as_dict() for l in layers]}, indent=2))
    else:
        print(f"COMPLETION LEDGER — {a.field} @ {a.target_org}")
        width = max(len(l.title) for l in layers)
        for l in layers:
            print(f"  {l.title.ljust(width)}  {l.outcome}")
            print(f"  {' ' * width}  {l.detail}")
        print()
        if done:
            print(f"  DONE. {len(observed)} verified by the org, {len(asserted)} asserted "
                  f"by a person, {len(inapplicable)} declared inapplicable.")
            if asserted:
                print(f"  {len(asserted)} of {len(layers)} layers rest on somebody's word. "
                      f"That is not the same as the org answering.")
        else:
            short = [l.key for l in layers if l.outcome not in GREEN]
            print(f"  NOT DONE. {len(observed)} verified by the org, {len(asserted)} "
                  f"asserted. Outstanding: {', '.join(short)}.")
            print(f"  The word is not available yet. That is the whole point of asking.")
    return 0 if done else 3


def main():
    p = argparse.ArgumentParser(prog="torque done", description=__doc__.split("\n")[0])
    p.add_argument("--target-org", required=True)
    p.add_argument("--field", required=True, metavar="Object.Field__c")
    p.add_argument("--permset")
    p.add_argument("--profile", help="the NON-ADMIN profile the change is for")
    p.add_argument("--as-user", metavar="USERNAME_OR_ID",
                   help="the non-admin user to impersonate for the automated render. Admins, "
                        "inactive users and the session's own user are refused: each renders "
                        "perfectly and proves nothing.")
    p.add_argument("--record-id", metavar="ID",
                   help="a record whose page should show the field (use a TEST-prefixed "
                        "record). Required alongside --as-user for the automated render.")
    p.add_argument("--render-evidence",
                   help="what a person saw, under which profile, when. Reports ASSERTED — the "
                        "automated render (--as-user + --record-id) is how this layer gets "
                        "VERIFIED by the org itself.")
    p.add_argument("--automation-evidence", help="what was observed, not what was expected")
    p.add_argument("--uat-evidence", help="who used it, when, and what they saw")
    p.add_argument("--na", action="append", metavar="LAYER:REASON",
                   help="declare a layer inapplicable, with a reason (repeatable). Refused for "
                        "BLOCKED layers.")
    p.add_argument("--json", action="store_true")
    a = p.parse_args()
    sys.exit(render(build(a), a))


if __name__ == "__main__":
    main()
